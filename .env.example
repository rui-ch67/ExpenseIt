# Copy to .env.local for local development. Never commit real values.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# ── Database (Neon) ───────────────────────────────────────────────────────
# On Vercel these are set by the Neon integration. They're marked Sensitive, so
# `vercel env pull` leaves them blank: for local development, create a `dev`
# branch in the Neon console (Branches → New branch) and paste its connection
# strings here, so local experiments never touch production data.
# Pooled connection for the app; unpooled (direct) one for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Receipt images (Vercel Blob) ──────────────────────────────────────────
# Set on Vercel by the Blob integration. Sensitive, so for local development
# copy it from Vercel → Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# ── Sign-in (Better Auth) ─────────────────────────────────────────────────
# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public URL. Locally http://localhost:3000; in production your Vercel domain.
BETTER_AUTH_URL=http://localhost:3000

# ── Receipt OCR (Google Gemini) ───────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (defaults to a Flash model; see src/infrastructure/ocr).
GEMINI_MODEL=

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Vercel Cron sends this as a bearer token to /api/cron/*. Any long random string.
CRON_SECRET=
