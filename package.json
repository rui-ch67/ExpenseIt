{
  "name": "expenseit",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "vercel-build": "drizzle-kit migrate && next build",
    "ocr:try": "tsx --tsconfig tsconfig.json scripts/try-receipt-ocr.mts",
    "smoke:receipts": "tsx --tsconfig tsconfig.json scripts/smoke-receipts.mts",
    "capture": "tsx scripts/capture.mts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  }
}
